<?xml version="1.0" encoding="utf-8"?>
<!-- One mark: the chapter on the left, its whole-book figure on the right.

     No leaders here. Leaders are the app's device for "this name points at that place in the book",
     and they belong to Contents; a mark is a saved position, and the tabular right column carries
     the figure on its own.

     No trailing ✕ either. One on every row would put forty pictograms on a surface built to avoid
     them, and it sat a finger's width from the panel's own dismiss — a mis-tap destroyed a mark
     with no confirmation and no undo. Removal is a long press, explained once under the "Remove"
     sidehead at the foot of the list.

     e-ink: no ripple, no animation, whole row is the tap target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:baselineAligned="true"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/row_height"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/bookmark_label"
        style="@style/Text.Row"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1" />

    <TextView
        android:id="@+id/bookmark_percent"
        style="@style/Text.Figure"
        android:layout_marginStart="@dimen/space" />

</LinearLayout>
