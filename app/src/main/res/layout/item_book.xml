<?xml version="1.0" encoding="utf-8"?>
<!-- One board on the shelf: a cover in a uniform trim, the book's title, its author.

     The frame hugs the artwork rather than boxing it. A cover is whatever shape it was scanned at,
     and drawing the frame around a fixed box meant every one that did not match sat inside a grey
     mat with bars above and below it — the mat, not the book, became the thing the frame appeared
     to be drawn around.

     But the *box* is fixed even though the frame is not, and the cover stands on its floor. Covers
     differ in aspect, so letting each set its own baseline left a row of boards hanging from a
     shared top edge at four different depths, with their captions stepping up and down after them.
     Bottom-aligning inside a fixed box puts every cover in a row on one line and starts every title
     at the same height, which is what makes a row scannable — and what a shelf looks like.

     The title takes two lines whether it needs them or not, for the same reason: it is what keeps
     the authors aligned across a row.

     match_parent on the frame, not wrap_content: a wrap_content frame measures its match_parent
     child against zero available width, and the cover collapsed to well under its column.

     No animation-bearing attributes — the grid's RecyclerView additionally runs with
     itemAnimator = null (see LibraryActivity), since a plain layout alone doesn't stop
     DefaultItemAnimator's cross-fade on data changes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/shelf_edge"
    android:paddingBottom="@dimen/board_gap">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/cover_box_height">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:adjustViewBounds="true"
            android:background="@drawable/cover_trim"
            android:contentDescription="@null"
            android:maxHeight="@dimen/cover_box_height"
            android:padding="@dimen/cell_border"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/progress_badge"
            style="@style/Text.Figure"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_tight"
            android:background="@drawable/progress_badge"
            android:paddingHorizontal="@dimen/space_hair"
            android:textColor="@color/reader_text_primary"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/title"
        style="@style/Text.Sub"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_tight"
        android:ellipsize="end"
        android:lines="2"
        android:textColor="@color/reader_text_primary" />

    <TextView
        android:id="@+id/author"
        style="@style/Text.Figure"
        android:layout_width="match_parent"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Why a book cannot be opened, when that is the case. -->
    <TextView
        android:id="@+id/status"
        style="@style/Text.Figure"
        android:layout_width="match_parent"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
