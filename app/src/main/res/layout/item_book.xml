<?xml version="1.0" encoding="utf-8"?>
<!-- One board on the shelf: a cover in a uniform trim, the book's title, its author.

     The frame hugs the artwork rather than a fixed box. A cover is whatever shape it was scanned
     at, and a fixed box meant every one that did not match sat inside a grey mat with bars above
     and below it — the mat, not the book, became the thing the frame was drawn around. The
     ImageView takes the column's width, adjusts its own height to the image's aspect, and the
     border follows it. Boards in a row therefore differ in height, which is what a real shelf
     looks like.

     No animation-bearing attributes — the grid's RecyclerView additionally runs with
     itemAnimator = null (see LibraryActivity), since a plain layout alone doesn't stop
     DefaultItemAnimator's cross-fade on data changes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_tight"
    android:paddingBottom="@dimen/board_gap">

    <!-- match_parent, not wrap_content. A wrap_content frame measures its match_parent child
         against zero available width, so the cover collapsed to well under its column and every
         board came out a third smaller than the shelf had room for. The frame takes the column;
         the ImageView takes the frame; adjustViewBounds gives back the height the artwork's own
         aspect asks for. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/cover"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:background="@drawable/cover_trim"
            android:contentDescription="@null"
            android:maxHeight="@dimen/cover_max_height"
            android:minHeight="@dimen/cover_min_height"
            android:padding="@dimen/cell_border"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/progress_badge"
            style="@style/Text.Figure"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/space_tight"
            android:background="@drawable/progress_badge"
            android:paddingHorizontal="@dimen/space_hair"
            android:textColor="@color/reader_text_primary"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/title"
        style="@style/Text.Sub"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_tight"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/reader_text_primary" />

    <TextView
        android:id="@+id/author"
        style="@style/Text.Figure"
        android:layout_width="match_parent"
        android:ellipsize="end"
        android:maxLines="1" />

    <!-- Why a book cannot be opened, when that is the case. -->
    <TextView
        android:id="@+id/status"
        style="@style/Text.Figure"
        android:layout_width="match_parent"
        android:ellipsize="end"
        android:maxLines="1" />

</LinearLayout>
