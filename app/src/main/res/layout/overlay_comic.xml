<?xml version="1.0" encoding="utf-8"?>
<!-- The comic reader's chrome, which is the reader's chrome with one word different.

     Same two rows, same EDGE rule, same foot, same dismiss in the same place — so a reader who has
     learned the book surface has already learned this one. Three deliberate differences, each
     following from what a comic actually is:

       * The first destination reads MARKS, not CONTENTS. A comic has no chapters, and a three-cell
         segment with one live cell is worse than no segment at all — so the back-matter surface
         behind it offers marks alone and drops the segment row entirely (BackMatterPanel
         .hasChapters = false).
       * The running head carries the reading direction where a book carries its chapter. It is the
         one fact about a comic that is not obvious from the page, and the one setting people flip
         per book. Tapping it flips it.
       * The page sits on a VEIL mat. A comic page fitted to this screen leaves letterboxing, and a
         black surround would be a large ink flood on a reflective panel fighting the artwork it
         frames. VEIL reads as a mat, which is what a printed comic gets.

     Touch model, e-ink constraints and the scrubber's reuse are all as overlay_reader.xml: the root
     is not clickable, so page-area taps fall through to ComicPageView, which dismisses the overlay.

     The ChapterScrubberView is reused UNCHANGED — its trusted-lift gesture grammar took several
     rounds of on-device debugging against this panel's firmware, and nothing here touches it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comic_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- ===== Chrome, top ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/paper"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/chrome_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_screen">

            <TextView
                android:id="@+id/comic_back"
                style="@style/ChromeGlyph.Back"
                android:contentDescription="@string/action_back" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Opens the marks surface. Still a word rather than the book reader's ribbon glyph:
                 there is no chapters segment behind it, so this is the comic's only destination and
                 naming it is worth more than saving the width. Marking the page itself is the first
                 row inside, written as a sentence that names the page it would act on. -->
            <TextView
                android:id="@+id/comic_bookmarks_button"
                style="@style/Text.Mark.Destination"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="@dimen/tap_target_min"
                android:minWidth="@dimen/tap_target_min"
                android:paddingStart="@dimen/space"
                android:text="@string/segment_marks" />

        </LinearLayout>

        <!-- The running head: the comic on the left, its reading direction on the right, where a
             book puts its chapter. Tapping the direction flips it for this comic. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/chrome_running_head_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_screen">

            <TextView
                android:id="@+id/comic_title"
                style="@style/Text.Sub"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/comic_direction_button"
                style="@style/Text.Mark"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/space"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical|end"
                android:minWidth="@dimen/tap_target_min" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/rule_chrome"
            android:background="@color/reader_rule" />

    </LinearLayout>

    <!-- The scrubbing preview, with the same reversed caption bar the book reader's has — page
         figures rather than a chapter, because that is what a comic reader counts in. Decoded on
         demand as the finger moves; the page underneath never repaints during a drag. -->
    <LinearLayout
        android:id="@+id/comic_preview_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="140dp"
        android:background="@drawable/preview_window_border"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/comic_preview_page"
            style="@style/Text.Mark"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/ink"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space"
            android:textColor="@color/paper" />

        <!-- Half screen: 374x499dp at the Nomad's 1.875 density = ~702x936px, matching the book
             reader's preview exactly. -->
        <ImageView
            android:id="@+id/comic_preview"
            android:layout_width="374dp"
            android:layout_height="499dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <!-- ===== Chrome, foot =====
         Identical to the book reader's, and deliberately so: the strip is the one element that
         should feel the same everywhere. A comic has no chapters, so the track is one plain run
         rather than a ticked one — set in ComicActivity, not here. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/paper"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/rule_chrome"
            android:background="@color/reader_rule" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/comic_readout"
                style="@style/Text.Figure"
                android:layout_width="match_parent"
                android:gravity="center"
                android:paddingHorizontal="@dimen/margin_screen"
                android:paddingTop="@dimen/space" />

            <TextView
                android:id="@+id/comic_scrubber_back"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="@dimen/space_hair"
                android:background="@drawable/return_seat"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/scrubber_back"
                android:textColor="@color/reader_text_primary"
                android:textSize="@dimen/text_glyph"
                android:visibility="gone" />

        </FrameLayout>

        <dev.reader.ui.ChapterScrubberView
            android:id="@+id/comic_scrubber"
            android:layout_width="match_parent"
            android:layout_height="@dimen/scrubber_strip_height"
            android:paddingHorizontal="@dimen/margin_screen" />

    </LinearLayout>

    <!-- ===== Marks =====
         The book reader's back-matter surface with only the Marks segment in it: same header, same
         ‹ at the same margin, same "Mark this page" cell at the head of the list. Not a different
         screen — a shorter header. -->
    <LinearLayout
        android:id="@+id/comic_bookmarks_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_screen">

            <TextView
                android:id="@+id/comic_bookmarks_close"
                style="@style/PanelDismiss"
                android:contentDescription="@string/panel_close_contents" />

            <TextView
                style="@style/Text.Mark"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/segment_marks" />

            <TextView
                android:id="@+id/comic_bookmarks_book"
                style="@style/Text.Sub"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="italic" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/rule_head"
            android:layout_marginHorizontal="@dimen/margin_screen"
            android:background="@color/reader_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_loose">

            <TextView
                android:id="@+id/comic_bookmark_toggle"
                style="@style/Cell.Action"
                android:layout_width="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center" />

            <TextView
                android:id="@+id/comic_bookmark_subject"
                style="@style/Text.Figure"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_tight"
                android:gravity="center" />

            <dev.reader.ui.SideheadView
                android:id="@+id/comic_marks_sidehead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_loose" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/comic_bookmarks_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/space_snug"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/comic_bookmarks_empty"
                    style="@style/Text.Sub"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_wide"
                    android:text="@string/comic_marks_empty_hint"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
