<?xml version="1.0" encoding="utf-8"?>
<!-- The comic reader's chrome, which is the reader's chrome with a smaller vocabulary.

     Same two rows in the same SHAPE — ‹, the title beside it, the destinations at the right, the
     running-head row beneath, the same EDGE rule and foot — so a reader who has learned the book
     surface has already learned this one. The differences follow from what a comic actually is:

       * The destinations are the ribbon and MARKS, where the book has the ribbon, Aa and the
         contents glyph. A comic has no chapters (the back-matter surface offers marks alone) and
         no type to set, so those two would be dead here. MARKS stays a WORD rather than borrowing
         the book's contents glyph: that glyph draws a contents page, which is precisely the thing
         a comic does not have, and with only one destination on the row there is width to name it.
         The ribbon marks the page in place, exactly as the book's does.
       * The running-head row carries the reading direction where a book carries its chapter. It is
         the one fact about a comic that is not obvious from the page, and the one setting people
         flip per book. Tapping it flips it.
       * The page sits on a VEIL mat. A comic page fitted to this screen leaves letterboxing, and a
         black surround would be a large ink flood on a reflective panel fighting the artwork it
         frames. VEIL reads as a mat, which is what a printed comic gets.

     Touch model, e-ink constraints and the scrubber's reuse are all as overlay_reader.xml: the root
     is not clickable, so page-area taps fall through to ComicPageView, which dismisses the overlay.

     The ChapterScrubberView is reused UNCHANGED — its trusted-lift gesture grammar took several
     rounds of on-device debugging against this panel's firmware, and nothing here touches it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/comic_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <!-- ===== Chrome, top ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/paper"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/chrome_row_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_screen">

            <ImageView
                android:id="@+id/comic_back"
                style="@style/Chevron"
                android:contentDescription="@string/action_back" />

            <!-- The comic's title, in the seat the book's title holds — beside the way out. No
                 start margin: the chevron's mark sits at the start of its box, whose empty
                 remainder is the gap (see the Chevron style). -->
            <TextView
                android:id="@+id/comic_title"
                style="@style/Text.Sub.BookTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="italic" />

            <!-- The mark ribbon, exactly as the book's: outlined when this page is unmarked,
                 flooded when marked, tap to toggle. -->
            <ImageView
                android:id="@+id/comic_bookmark_button"
                android:layout_width="@dimen/tap_target_min"
                android:layout_height="@dimen/tap_target_min"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/bookmark_add"
                android:padding="@dimen/glyph_inset"
                android:src="@drawable/ic_bookmark" />

            <!-- Opens the marks surface. There is no chapters segment behind it, so this is the
                 comic's only destination and naming it is worth more than saving the width. -->
            <TextView
                android:id="@+id/comic_bookmarks_button"
                style="@style/Text.Mark.Destination"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:layout_marginEnd="@dimen/edge_reach_pull"
                android:minHeight="@dimen/tap_target_glyph"
                android:minWidth="@dimen/tap_target_min"
                android:paddingStart="@dimen/space"
                android:paddingEnd="@dimen/edge_reach"
                android:text="@string/segment_marks" />

        </LinearLayout>

        <!-- The running-head row: the reading direction, centred where a book centres its chapter.
             It is a control as well as a fact — tapping it flips the direction for this comic. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/chrome_running_head_height"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_screen">

            <TextView
                android:id="@+id/comic_direction_button"
                style="@style/Text.Mark"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="@dimen/tap_target_min" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/rule_chrome"
            android:background="@color/reader_rule" />

    </LinearLayout>

    <!-- The scrubbing preview, with the same reversed caption bar the book reader's has — page
         figures rather than a chapter, because that is what a comic reader counts in. Decoded on
         demand as the finger moves; the page underneath never repaints during a drag. -->
    <LinearLayout
        android:id="@+id/comic_preview_frame"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="140dp"
        android:background="@drawable/preview_window_border"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/comic_preview_page"
            style="@style/Text.Mark"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/ink"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space"
            android:textColor="@color/paper" />

        <!-- Half screen: 374x499dp at the Nomad's 1.875 density = ~702x936px, matching the book
             reader's preview exactly. -->
        <ImageView
            android:id="@+id/comic_preview"
            android:layout_width="374dp"
            android:layout_height="499dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />

    </LinearLayout>

    <!-- ===== Chrome, foot =====
         Identical to the book reader's, and deliberately so: the strip is the one element that
         should feel the same everywhere. A comic has no chapters, so the track is one plain run
         rather than a ticked one — set in ComicActivity, not here. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/paper"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/rule_chrome"
            android:background="@color/reader_rule" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/comic_readout"
                style="@style/Text.Figure"
                android:layout_width="match_parent"
                android:gravity="center"
                android:paddingHorizontal="@dimen/margin_screen"
                android:paddingTop="@dimen/space" />

            <!-- The book reader's return control, verbatim — see overlay_reader.xml for why it is
                 a word rather than a ↩ on a ring. -->
            <TextView
                android:id="@+id/comic_scrubber_back"
                style="@style/Text.Mark.Destination"
                android:layout_gravity="start|center_vertical"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start|center_vertical"
                android:minHeight="@dimen/tap_target_glyph"
                android:paddingStart="@dimen/edge_reach"
                android:paddingEnd="@dimen/space"
                android:text="@string/scrubber_back"
                android:visibility="gone" />

        </FrameLayout>

        <dev.reader.ui.ChapterScrubberView
            android:id="@+id/comic_scrubber"
            android:layout_width="match_parent"
            android:layout_height="@dimen/scrubber_strip_height"
            android:paddingHorizontal="@dimen/margin_screen" />

    </LinearLayout>

    <!-- ===== Marks =====
         The book reader's back-matter surface with only the Marks segment in it: same header, same
         ‹ at the same margin, same "Mark this page" cell at the head of the list. Not a different
         screen — a shorter header. -->
    <LinearLayout
        android:id="@+id/comic_bookmarks_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/paper"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/margin_screen">

            <ImageView
                android:id="@+id/comic_bookmarks_close"
                style="@style/Chevron"
                android:contentDescription="@string/panel_close_contents" />

            <TextView
                style="@style/Text.Mark"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/segment_marks" />

            <TextView
                android:id="@+id/comic_bookmarks_book"
                style="@style/Text.Sub"
                android:ellipsize="end"
                android:maxLines="1"
                android:textStyle="italic" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/rule_head"
            android:layout_marginHorizontal="@dimen/margin_screen"
            android:background="@color/reader_rule" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/margin_screen"
            android:paddingTop="@dimen/space_loose">

            <TextView
                android:id="@+id/comic_bookmark_toggle"
                style="@style/Cell.Action"
                android:layout_width="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center" />

            <TextView
                android:id="@+id/comic_bookmark_subject"
                style="@style/Text.Figure"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/space_tight"
                android:gravity="center" />

            <dev.reader.ui.SideheadView
                android:id="@+id/comic_marks_sidehead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_loose" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/comic_bookmarks_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/space_snug"
                    android:scrollbars="vertical" />

                <TextView
                    android:id="@+id/comic_bookmarks_empty"
                    style="@style/Text.Sub"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/space_wide"
                    android:text="@string/comic_marks_empty_hint"
                    android:visibility="gone" />

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
