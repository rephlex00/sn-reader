<?xml version="1.0" encoding="utf-8"?>
<!-- How far into a book you are, sitting on the artwork.

     Graded rather than tinted: an INK ground with a PAPER outline holds on any board this shelf can
     show — the ground separates it from a white cover, the outline separates it from a dark one,
     and on a greyscale panel there is no third case. It was previously the inverse (white fill,
     1dp black hairline), which lost its edge against the many pale public-domain covers and drew
     that edge at a weight this panel cannot resolve.

     Square, like every other mark in the app. No gradient, no shadow: both ghost on e-ink. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ink" />
    <stroke
        android:width="@dimen/cell_border"
        android:color="@color/paper" />
</shape>
