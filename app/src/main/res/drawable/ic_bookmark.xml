<?xml version="1.0" encoding="utf-8"?>
<!-- The mark glyph, unmarked: a ribbon drawn in outline. Its filled twin (ic_bookmark_filled) is
     the same path, so the toggle is one shape gaining ink rather than two different pictures —
     which is what makes "this page is marked" readable at a glance with no colour to spend.

     Stroked at 2 in a 24 viewport: at the 30dp the chrome renders it, that is ~4px on the panel,
     which clears the weight below which a line dithers into grey on this glass. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/reader_text_primary">
    <path
        android:fillColor="#00000000"
        android:pathData="M6,3 L18,3 L18,21 L12,16.5 L6,21 Z"
        android:strokeColor="#FF000000"
        android:strokeLineJoin="round"
        android:strokeWidth="2" />
</vector>
