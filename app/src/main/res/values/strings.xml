<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-facing string in the app.

  Error messages here are deliberately plain-language and carry no exception text. The raw
  throwable goes to Log.w with a tag, where it is useful to whoever is debugging; a reader who
  taps a damaged book should be told the book is damaged, not shown "error in opening zip file"
  or a bare "NullPointerException".
-->
<resources>
    <string name="app_name">Reader</string>

    <!-- Library -->
    <string name="library_title">Library</string>
    <string name="library_search_hint">Search title or author</string>
    <!-- The shelf's own count, the way a half-title page names what follows it. -->
    <string name="library_count">%1$d books · %2$d started</string>
    <string name="library_count_one">%1$d book · %2$d started</string>
    <string name="library_found">%1$d found</string>
    <string name="library_nothing_yet">Nothing found yet</string>

    <!-- View, filter and sort, as cells. Short because eight of them share one row. -->
    <string name="view_covers">Covers</string>
    <string name="view_list">List</string>
    <string name="folders_nested">Folders</string>
    <string name="folders_flat">Flat</string>
    <string name="filter_new">New</string>
    <string name="filter_reading">Reading</string>
    <string name="filter_done">Done</string>
    <string name="sort_by">Sort by</string>
    <string name="sort_added">Added</string>
    <string name="sort_opened">Opened</string>
    <string name="sort_title">Title</string>
    <string name="sort_author">Author</string>

    <!-- The list view's two sideheads: the two states a shelf actually has. -->
    <string name="shelf_reading_now">Reading now</string>
    <string name="shelf_not_started">Not started</string>
    <string name="menu_search">Search</string>
    <string name="menu_sort_by">Sort by</string>
    <string name="menu_sort_title">Title</string>
    <string name="menu_sort_author">Author</string>
    <string name="menu_sort_recently_added">Recently added</string>
    <string name="menu_sort_recently_opened">Recently opened</string>
    <string name="menu_view">View</string>
    <string name="menu_view_tiles">Tiles</string>
    <string name="menu_view_list">List</string>
    <string name="menu_flatten_folders">Flatten folders</string>
    <string name="menu_filter">Filter</string>
    <string name="filter_all">All</string>
    <string name="filter_not_started">Not started</string>
    <string name="filter_in_progress">In progress</string>
    <string name="filter_finished">Finished</string>
    <string name="menu_settings">Settings</string>

    <!-- Book status shown under a title -->
    <string name="status_in_progress">In progress</string>
    <string name="status_not_started">Not started</string>
    <string name="status_unreadable">Can\'t be opened</string>
    <string name="folder_row_label">▸ %1$s (%2$d)</string>

    <!-- Library empty and permission states -->
    <string name="library_empty_title">No books yet</string>
    <string name="library_empty_hint">Drop EPUB, CBZ or CBR files into the folder below and open Reader again. Scanning is incremental, so a large library does not mean a slow start.</string>
    <string name="library_scan_again">Scan again</string>
    <string name="library_permission_fact">Reader needs all-files access to read your books. Settings › Apps › Special access › All files access › Reader.</string>
    <string name="library_empty_no_matches">No books match. Clear the search or filter to see your library.</string>
    <string name="library_permission_needed">Reader needs permission to read your files before it can show your library. Tap here to grant it.</string>
    <string name="library_permission_prompt">Reader needs all-files access to open books.</string>

    <!-- Reader chrome. Words, plus the one sanctioned glyph. "‹ Library" names a place rather
         than an action the device has no button for; "Type" names the thing the second surface
         changes, where "Aa" was a ligature in a row of words and "Display" named a screen. -->
    <string name="reader_back">‹ Library</string>
    <string name="reader_contents">Contents</string>
    <string name="reader_type">Type</string>

    <!-- The back-matter segment. "Marks" and "Notes" rather than Bookmarks and Highlights: they
         fit three-up without truncating, and they are what a reader of a printed book calls them.
         A comic has no chapters, so its segment is Marks alone. -->
    <string name="segment_chapters">Chapters</string>
    <string name="segment_marks">Marks</string>
    <string name="segment_notes">Notes</string>

    <!-- The running head's right-hand side, and the comic equivalent. -->
    <string name="running_direction_ltr">Left to right</string>
    <string name="running_direction_rtl">Right to left</string>

    <!-- A Contents row's whole-book position, at the end of its leader dots. -->
    <string name="toc_percent">%1$d%%</string>

    <!-- Reader panels -->
    <string name="panel_close_contents">Back to the page</string>
    <string name="panel_close_type">Back to the page</string>
    <string name="back_to_the_page">‹  Back to the page</string>

    <!-- Contents groups the EPUB's front matter under a name instead of letting the publisher's
         spine text ("Frankenstein;", "or, the Modern Prometheus") read as navigation. -->
    <string name="toc_group_front_matter">Front matter</string>
    <string name="toc_group_chapters">Chapters</string>

    <!-- Empty states. Declarative, never an apology, and each says the one thing a reader who has
         hit it does not yet know. -->
    <string name="contents_empty">Nothing listed</string>
    <string name="contents_empty_hint">This book carries no table of contents. The timeline at the foot of the page still moves you through it.</string>
    <string name="marks_empty">Nothing marked yet</string>
    <string name="marks_empty_hint">Mark this page with the cell above. A mark remembers the page, not the percentage.</string>
    <string name="notes_empty">Nothing marked yet</string>
    <!-- The only place in the app the pen can be explained — a reader who does not know this will
         never make a highlight. -->
    <string name="notes_empty_hint">Drag the pen across a passage while you read. Your finger and your palm are ignored, so you can rest a hand on the glass.</string>
    <string name="marks_kept_per_book">Marks and notes are kept per book, and survive an update.</string>
    <string name="comic_marks_empty_hint">Nothing marked yet. Use the cell above to mark the page you are on.</string>

    <string name="bookmark_add">Mark this page</string>
    <string name="bookmark_remove">Remove this mark</string>
    <string name="bookmark_subject">%1$s · page %2$d of %3$d</string>
    <string name="marks_remove_hint">Tap and hold a mark to remove it. Marks are not deleted when a book is re-scanned.</string>
    <string name="notes_remove_hint">Tap a note on the page to remove it. %1$d in this book.</string>
    <string name="marks_sidehead">Marked</string>
    <string name="remove_sidehead">Remove</string>
    <string name="bookmark_delete">Delete bookmark</string>
    <string name="highlight_delete">Delete highlight</string>
    <string name="highlight_delete_chip">✕ Delete</string>

    <!-- Type. Sections name what each group changes: the face, the page, this book, the screen,
         previews. Grouping is what turns nine switches into four decisions. -->
    <string name="type_head_face">The face</string>
    <string name="type_head_page">The page</string>
    <string name="type_head_book">This book</string>
    <string name="type_head_screen">The screen</string>
    <string name="type_head_previews">Previews</string>

    <string name="font_literata">Literata</string>
    <string name="font_bitter">Bitter</string>
    <string name="font_atkinson">Atkinson</string>

    <!-- Every boolean in the app is this pair, in the same shape as every other choice. -->
    <string name="cell_on">On</string>
    <string name="cell_off">Off</string>

    <!-- The size cells are drawn as the letters they produce, so a size is chosen by looking at
         it rather than by reading a developer's unit. -->
    <string name="text_size_specimen">Aa</string>

    <string name="setting_line_spacing">Line spacing</string>
    <!-- Named, not numbered: 1.2 / 1.4 / 1.6 is a stylesheet leaking into the interface. -->
    <string name="spacing_tight">Tight</string>
    <string name="spacing_normal">Normal</string>
    <string name="spacing_open">Open</string>
    <string name="setting_margins">Margins</string>
