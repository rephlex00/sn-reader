    <string name="previews_delete_action">Delete previews</string>

    <!-- Settings and folder chooser -->
    <string name="settings_title">Settings</string>
    <string name="settings_book_folder">Folder</string>
    <string name="settings_change_folder">Change folder</string>
    <string name="settings_head_books">Your books</string>
    <string name="settings_head_colophon">Colophon</string>
    <string name="settings_no_network">No accounts, no sync, no network. Everything — your places, marks and notes — is stored on this device only.</string>
