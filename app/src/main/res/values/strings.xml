    <string name="error_open_highlight">That highlight couldn\'t be opened.</string>
    <string name="error_open_section">That section couldn\'t be opened.</string>
    <string name="error_save_bookmark">That bookmark couldn\'t be saved.</string>
    <string name="error_save_highlight">That highlight couldn\'t be saved.</string>
