    <string name="chooser_up">Up</string>
    <string name="chooser_use_this_folder">Use this folder</string>
    <string name="action_back">Back</string>

    <!-- Failures. Plain language; the throwable goes to the log, never here. -->
    <string name="error_open_book">This book couldn\'t be opened. It may be damaged or in a format Reader doesn\'t support.</string>
    <string name="error_book_missing">That book is no longer there.</string>
    <string name="error_book_no_text">This book has no readable text.</string>
    <string name="error_no_text_short">No readable text</string>

    <!-- The scrubber's readout while dragging: chapter title, then whole-book percentage. -->
    <!-- The preview window's caption bar: the chapter on the left, this figure on the right. -->
    <string name="scrub_preview_position">%1$d%%</string>
    <string name="scrubber_position">%1$s · %2$d%%</string>

    <!-- The resting readout while a preview strip is actively generating (and the drag isn't in
         flight, so this readout is the one showing): whole-book percentage complete. -->
    <string name="previews_preparing">preparing previews · %1$d%%</string>

    <!-- The back control beside the scrubber: pops the jump stack. The glyph is universal and a
         word would crowd the readout. -->
    <string name="scrubber_back">↩</string>
    <string name="error_turn_page">Something went wrong turning the page.</string>
    <string name="error_apply_setting">That setting couldn\'t be applied.</string>
