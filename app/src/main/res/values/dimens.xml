<?xml version="1.0" encoding="utf-8"?>
<!--
  The type scale, the 8dp grid, and the three rule weights.

  Sizes are sp; the panel runs at density 1.875, so 20sp is 37 device px. The design was drawn at
  1404 x 1872 device px and the values below are that drawing divided through, snapped to the grid.

  Two places where the drawings and the written system disagreed, and how they are resolved here:

    * Row height. The drawings put a list row at 100px (53dp) and say so in as many words; the
      written system says 72dp. The drawings win — they are the concrete reference and 13 rows of
      contents beats 9 — but 53dp is not on the 8dp grid, so rows are 56dp. Same for the panel
      header: drawn at 100px, set here at 56dp.
    * Section rule. The drawings draw it at 2px, which is barely 1dp; the written system says 2dp
      and separately forbids 1dp as invisible on glass. The written system wins: a hairline rule
      disappearing on this panel is the exact defect the overhaul exists to fix.

  48dp remains the tap-target floor everywhere, and every tappable dimension below clears it.
-->
<resources>

    <!-- ===== The grid ===== -->

    <!-- Every left and right edge in the app, including a panel header's dismiss glyph. -->
    <dimen name="margin_screen">32dp</dimen>

    <!-- The vertical module. Blocks of space are whole numbers of these. -->
    <dimen name="module">24dp</dimen>

    <dimen name="space_hair">4dp</dimen>
    <dimen name="space_tight">8dp</dimen>
    <dimen name="space_snug">12dp</dimen>
    <dimen name="space">16dp</dimen>
    <dimen name="space_loose">24dp</dimen>
    <dimen name="space_wide">32dp</dimen>
    <dimen name="space_section">48dp</dimen>
    <dimen name="space_title">64dp</dimen>

    <!-- ===== Rules. All INK; a lighter rule is not a quieter rule, it is an absent one. ===== -->

    <!-- Where a surface meets another surface: chrome against page, the foot of a panel. One per
         edge, and the one boundary in the app that must never be ambiguous. -->
    <dimen name="rule_edge">6dp</dimen>

    <!-- The reader chrome's two edges, and only those. Every other EDGE rule separates one piece of
         furniture from another; these two sit directly against the book's own page, and at 6dp they
         read as bars the text has to look past rather than as the boundary of the chrome. The
         boundary is still unambiguous at this weight — the chrome above it is a paper bar full of
         controls, not another column of prose. -->
    <dimen name="rule_chrome">2dp</dimen>

    <!-- Under a panel header or a segmented header: "everything below belongs to this". -->
    <dimen name="rule_head">4dp</dimen>

    <!-- Between kinds of content inside a surface, carrying a tracked caps label on it. -->
    <dimen name="rule_section">2dp</dimen>

    <!-- ===== Structure ===== -->

    <!-- Panel and library header. Drawn at 53dp, snapped up to the grid. -->
    <dimen name="header_height">56dp</dimen>

    <!-- A single-line list row: contents, settings, library list. -->
    <dimen name="row_height">56dp</dimen>

    <!-- A two-line row: a mark with its opening words, a library row with author and place. -->
    <dimen name="row_height_two_line">80dp</dimen>

    <!-- The scrubber strip. Hardware-learned geometry — the trusted-lift gesture grammar was
         tuned against this panel's firmware at this height. Do not tidy it into the grid. -->
    <dimen name="scrubber_strip_height">88dp</dimen>

    <!-- The reader's two chrome rows: destinations, then the running head. -->
    <dimen name="chrome_row_height">56dp</dimen>
    <dimen name="chrome_running_head_height">40dp</dimen>

    <!-- ===== The cell — one shape for every choice ===== -->

    <dimen name="cell_height">48dp</dimen>
    <dimen name="cell_min_width">88dp</dimen>
    <dimen name="cell_border">2dp</dimen>
    <dimen name="cell_padding_h">16dp</dimen>

    <!-- ===== Type ===== -->

    <!-- Empty-state statement, the library half-title. One per screen, at most. -->
    <dimen name="text_title">38sp</dimen>
    <!-- A book's name on a library list row; a panel's subject line. -->
    <dimen name="text_head">30sp</dimen>
    <!-- Cover captions in the grid; a quoted note. -->
    <dimen name="text_lead">24sp</dimen>
    <!-- Every primary list row, and a cell's label. -->
    <dimen name="text_row">20sp</dimen>
    <!-- The second line of a two-line row. The smallest size MIST may use. -->
    <dimen name="text_sub">17sp</dimen>
    <!-- Figures and metadata, SLATE, always tabular. The floor for SLATE. -->
    <dimen name="text_figure">15sp</dimen>
    <!-- Tracked caps: panel titles, sideheads, running heads, segment and cell labels. IRON.
         Uppercase because Literata has no true small caps. -->
    <dimen name="text_mark">13sp</dimen>

    <!-- The tracking on every caps label. Android takes letterSpacing in ems. -->
    <item name="tracking_caps" format="float" type="dimen">0.20</item>

    <!-- The single sanctioned glyph, and the jump-back mark. -->
    <dimen name="text_glyph">24sp</dimen>

    <!-- The same ‹, in the reader's chrome. Larger than a panel's, because a panel's dismiss sits
         on a header it shares with one title, while this one sits on a bar over a full page of text
         and is the only way out of the book. At label size it was a piece of punctuation. -->
    <dimen name="text_glyph_chrome">36sp</dimen>

    <!-- The current-place mark: a block in the left margin, next to a bold row. Three signals
         mark "here", because greyscale has no fourth. -->
    <dimen name="place_mark_width">6dp</dimen>
    <dimen name="place_mark_height">24dp</dimen>

    <!-- Leader dots: IRON, at this pitch, only where a row points to a place. -->
    <dimen name="leader_dot_size">2dp</dimen>
    <dimen name="leader_dot_pitch">8dp</dimen>

    <!-- The boards' own outer edge. The grid's items carry this as their horizontal padding, and
         the half-title's rule runs to it too, so the rule underlines the shelf rather than stopping
         short of the books it heads. -->
    <dimen name="shelf_edge">8dp</dimen>

    <!-- The inset inside a glyph's 48dp tap target. 9dp leaves a 30dp mark: the tap target is
         unchanged, the glyph itself is a quarter larger than the 24dp it started at. -->
    <dimen name="glyph_inset">9dp</dimen>

    <!-- The box a cover is bottom-aligned inside. Fixed, so every board in a row sits on the same
         line and the titles beneath them start at the same height — covers differ in aspect, and
         letting each one set its own baseline left the row's captions stepping up and down.

         Sized so three rows of four fill a page: at 210dp a board plus its one-line caption and the
         gap under it comes to 278dp, and three of those is the 834dp the shelf has to give. -->
    <dimen name="cover_box_height">210dp</dimen>

    <!-- A board's caption. Smaller than a list row's, because a cover is already carrying the
         book's identity and the words under it are only confirming it.

         The author stays at the figure size rather than dropping with the title: SLATE's floor is
         15sp — below that it washes out under reflected light, which is the whole reason the
         palette has a floor — and an author set in a darker grey to go smaller would end up
         louder than the title it sits under. -->
    <dimen name="text_board_title">15sp</dimen>

    <!-- A cover's height is the artwork's own, within these bounds. The maximum is what makes two
         rows of boards fit a page exactly; the minimum stops a wide, short scan collapsing to a
         strip that no longer reads as a book. -->


    <!-- The air under each board. -->
    <dimen name="board_gap">16dp</dimen>

    <!-- The minimum any tappable thing may be. -->
    <dimen name="tap_target_min">48dp</dimen>
</resources>
